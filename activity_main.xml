<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="32dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="CallBridge" android:textSize="32sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Bridge SIM calls with internet callers" android:textSize="14sp" android:layout_marginBottom="48dp"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMaster" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Master Phone" android:layout_marginBottom="16dp"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSlave" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Slave Phone" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
</LinearLayout>
